# Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server port (default: 6555)
PORT=6555

# CORS origin (your domain with https for Cloudflare)
# For local development: http://localhost:6556
# For production: https://youshandebo.xx.kg
CORS_ORIGIN=https://youshandebo.xx.kg

# Admin panel token
ADMIN_TOKEN=your_secure_token_here

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=120

# Billing integration
AFDIAN_WEBHOOK_TOKEN=your_afdian_token_here